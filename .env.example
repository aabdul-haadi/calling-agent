# Copy to .env and fill in. Never commit .env.

# --- Backend ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Options: a Postgres URL (Docker, Supabase...) or `pglite:.pglite/data` for a zero-install local database.
# pglite allows only ONE process at a time (stop `pnpm dev` before running `pnpm eval`).
DATABASE_URL=postgres://adk:adk@localhost:5432/adk
# Set true for hosted Postgres like Supabase (use its Postgres connection string, not the API keys)
DATABASE_SSL=false

# --- LLM (anthropic | openai) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Optional, for reasoning models like gpt-oss: low | medium | high (low = far fewer tokens, good for free tiers)
LLM_REASONING_EFFORT=
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
# Free / open-source models: set LLM_PROVIDER=openai and point this at an OpenAI-compatible server.
#   Ollama (local, no key):   OPENAI_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b
#   Groq (free tier):         OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b   (+ OPENAI_API_KEY, LLM_REASONING_EFFORT=low)
#   OpenRouter (free models): OPENAI_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a ":free" model>   (+ OPENAI_API_KEY)
OPENAI_BASE_URL=

# --- Embeddings (local | openai). "local" needs no key (hash-based, good enough for the demo) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Mock company systems ---
MOCK_PORT=4100
MOCK_SERVICES_URL=http://localhost:4100
# Fraction (0-1) of mock API calls that randomly fail with 503
MOCK_FAILURE_RATE=0
# Base latency in ms added to every mock API call
MOCK_LATENCY_MS=0
MOCK_CLIENT_ID=adk-backend
MOCK_CLIENT_SECRET=replace-me-client-secret
# Shared secret for signing handoff webhooks (HMAC SHA-256)
WEBHOOK_SECRET=replace-me-webhook-secret

# --- Optional: local voice gateway (Python, see voice-service/ and docs/VOICE.md) ---
# Any random string; the same value must be set for the voice service. Leave as-is to keep voice on the
# browser's own speech recognition.
VOICE_GATEWAY_SECRET=replace-me-voice-secret
VOICE_GATEWAY_URL=ws://localhost:8765/ws
VOICE_GATEWAY_HTTP_URL=http://localhost:8765

# --- Frontend ---
VITE_API_URL=http://localhost:4000

# Accurate second pass over each finished voice turn (off = streaming model only)
# VOICE_ASR_REFINE=parakeet-tdt-0.6b-v2
# Opt-in: save each voice turn's audio + transcripts locally for diagnosing recognition
# VOICE_DIAGNOSTICS=1
# The agent's voice: piper-amy-medium (default), piper-amy-low, piper-hfc-female-medium, piper-lessac-high, kokoro
# VOICE_TTS_MODEL=piper-amy-medium

# Knowledge base (PDF documents)
# EMBEDDING_PROVIDER=semantic   # semantic (local model, default), hash (offline word matching), openai
# RAG_RERANK=on                 # read the best few passages with a small local model before answering
# KNOWLEDGE_OCR=auto            # auto reads scanned pages with OCR; off never runs OCR
# KNOWLEDGE_MAX_UPLOAD_MB=100
# AGENT_SPECULATIVE=on          # start the model's answer while the message is classified (faster)
# VOICE_ACK_AFTER_S=0.8         # spoken "let me look that up" only if a real tool call is still running after this long
# VOICE_ACK_POLICY_AFTER_S=2.5   # same for a policy-document search (normally 0.1 s, so rarely spoken)
# VOICE_ACK_AGAIN_AFTER_S=6
# A smaller model just for classifying each message (faster, and its own rate limit). Same provider and key.
# LLM_CLASSIFIER_MODEL=openai/gpt-oss-20b
# AGENT_FAST_CLASSIFY=on        # answer a bare yes / no / greeting / thanks by rules (no model call)
# VOICE_PREFETCH_SILENCE_MS=300 # start the accurate transcript this far into the closing pause (0 = off)

# Learning from calls and chats (see docs/MACHINE_LEARNING.md)
# LEARNING_ENABLED=on              # off stops capture entirely
# LEARNING_RETENTION_DAYS=90       # unreviewed rows are deleted after this
# LEARNING_MIN_SFT_EXAMPLES=200    # approved examples before a fine-tuning dataset is "ready"
# LEARNING_MIN_INTENT_EXAMPLES=30  # approved intent examples before the local intent model retrains from live data
# LEARNING_SCHEDULE_MINUTES=0      # run the learning cycle on a schedule; 0 = by hand
# LEARNING_REVIEW_TOKEN=           # if set, the learning console needs this as a bearer token
