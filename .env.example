# Copy to .env and fill in. Never commit .env.

# --- Backend ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgres://adk:adk@localhost:5432/adk

# --- LLM (anthropic | openai) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# --- Embeddings (local | openai). "local" needs no key (hash-based, good enough for the demo) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Mock company systems ---
MOCK_PORT=4100
MOCK_SERVICES_URL=http://localhost:4100
# Fraction (0-1) of mock API calls that randomly fail with 503
MOCK_FAILURE_RATE=0
# Base latency in ms added to every mock API call
MOCK_LATENCY_MS=0
MOCK_CLIENT_ID=adk-backend
MOCK_CLIENT_SECRET=replace-me-client-secret
# Shared secret for signing handoff webhooks (HMAC SHA-256)
WEBHOOK_SECRET=replace-me-webhook-secret

# --- Frontend ---
VITE_API_URL=http://localhost:4000
