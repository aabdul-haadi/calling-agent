# Copy to .env.production (in the repository root) and fill in every value marked CHANGE.
# This file holds secrets: never commit it. Generate each secret with:  openssl rand -hex 32
#
# Compose reads "$" specially: write every literal "$" in a value as "$$".

# --- Where it lives -----------------------------------------------------------------------------
# A DNS A record for this name must already point at the server (ports 80 and 443 open).
DOMAIN=console.example.com                       # CHANGE
ACME_EMAIL=you@example.com                       # CHANGE: used only for the HTTPS certificate

# --- Secrets ------------------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE                         # CHANGE
MOCK_CLIENT_SECRET=CHANGE                        # CHANGE
WEBHOOK_SECRET=CHANGE                            # CHANGE (at least 8 characters)
VOICE_GATEWAY_SECRET=CHANGE                      # CHANGE

# --- Sign-in: production (recommended) ----------------------------------------------------------
# Needs an OpenID Connect provider (Auth0, Microsoft Entra ID, Keycloak, Okta, Google...).
# Setup steps are in docs/AUTHENTICATION.md. Register the redirect URI
#   https://<DOMAIN>/auth/callback    and the post-logout URI    https://<DOMAIN>/
NODE_ENV=production
AUTH_MODE=oidc
CADDYFILE=Caddyfile
OIDC_ISSUER=https://identity.example.com/tenant  # CHANGE (must be https)
OIDC_AUDIENCE=agent-delivery-api                 # CHANGE
OIDC_ROLE_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_ids
VITE_OIDC_CLIENT_ID=agent-delivery-web           # CHANGE
VITE_OIDC_SCOPE=openid profile email

# --- Sign-in: private demo only (replace the block above with this) -----------------------------
# Every visitor who gets past the password becomes an administrator. Not for real customer data.
#   NODE_ENV=development
#   AUTH_MODE=development
#   CADDYFILE=Caddyfile.demo
#   BASIC_AUTH_USER=demo
#   BASIC_AUTH_HASH=$$2a$$14$$...    # from: docker run --rm caddy:2-alpine caddy hash-password --plaintext '...'

# --- The AI model -------------------------------------------------------------------------------
LLM_PROVIDER=anthropic                           # anthropic or openai (openai also covers Groq, OpenRouter, Ollama)
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=CHANGE                         # when LLM_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=                                 # e.g. https://api.groq.com/openai/v1
LLM_REASONING_EFFORT=
LLM_FALLBACK_MODEL=
LLM_CLASSIFIER_MODEL=
EMBEDDING_PROVIDER=semantic

# --- Optional -----------------------------------------------------------------------------------
LOG_LEVEL=info
WITH_PDF=true                                    # false = smaller image, no PDF upload in the knowledge console
VOICE_ASR_THREADS=2
VOICE_ASR_REFINE_THREADS=2
VOICE_TTS_THREADS=2
