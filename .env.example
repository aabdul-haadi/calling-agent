# Copy to .env and fill in. Never commit .env.

# --- Backend ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Options: a Postgres URL (Docker, Supabase...) or `pglite:.pglite/data` for a zero-install local database.
# pglite allows only ONE process at a time (stop `pnpm dev` before running `pnpm eval`).
DATABASE_URL=postgres://adk:adk@localhost:5432/adk
# Set true for hosted Postgres like Supabase (use its Postgres connection string, not the API keys)
DATABASE_SSL=false

# --- LLM (anthropic | openai) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Optional, for reasoning models like gpt-oss: low | medium | high (low = far fewer tokens, good for free tiers)
LLM_REASONING_EFFORT=
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
# Free / open-source models: set LLM_PROVIDER=openai and point this at an OpenAI-compatible server.
#   Ollama (local, no key):   OPENAI_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b
#   Groq (free tier):         OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b   (+ OPENAI_API_KEY, LLM_REASONING_EFFORT=low)
#   OpenRouter (free models): OPENAI_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a ":free" model>   (+ OPENAI_API_KEY)
OPENAI_BASE_URL=

# --- Embeddings (local | openai). "local" needs no key (hash-based, good enough for the demo) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Mock company systems ---
MOCK_PORT=4100
MOCK_SERVICES_URL=http://localhost:4100
# Fraction (0-1) of mock API calls that randomly fail with 503
MOCK_FAILURE_RATE=0
# Base latency in ms added to every mock API call
MOCK_LATENCY_MS=0
MOCK_CLIENT_ID=adk-backend
MOCK_CLIENT_SECRET=replace-me-client-secret
# Shared secret for signing handoff webhooks (HMAC SHA-256)
WEBHOOK_SECRET=replace-me-webhook-secret

# --- Optional: local voice gateway (Python, see voice-service/ and docs/VOICE.md) ---
# Any random string; the same value must be set for the voice service. Leave as-is to keep voice on the
# browser's own speech recognition.
VOICE_GATEWAY_SECRET=replace-me-voice-secret
VOICE_GATEWAY_URL=ws://localhost:8765/ws
VOICE_GATEWAY_HTTP_URL=http://localhost:8765

# --- Frontend ---
VITE_API_URL=http://localhost:4000
